# Public chain configuration
NEXT_PUBLIC_TARGET_CHAIN_ID=46630
NEXT_PUBLIC_GENESIS_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_FRIENDENZA_CONTRACT=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TEST_TOKEN_ID=42
NEXT_PUBLIC_SITE_URL=https://friendenza.com
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/

# Server-only secrets. Generate separate values for development and production.
CHALLENGE_SECRET=replace-with-at-least-24-random-characters
AUTHORIZATION_PRIVATE_KEY=0x_replace_with_a_dedicated_64_hex_character_signing_key
PINATA_JWT=replace-with-pinata-server-jwt

# Foundry deployment scripts
DEPLOYER_PRIVATE_KEY=0x_replace_with_a_funded_testnet_only_private_key
GENESIS_CONTRACT=0x0000000000000000000000000000000000000000
AUTHORIZATION_SIGNER=0x0000000000000000000000000000000000000000
CONTRACT_OWNER=0x0000000000000000000000000000000000000000
TEST_HOLDER=0x0000000000000000000000000000000000000000
TEST_TOKEN_ID=42

# Mainnet uses a separate git-ignored .env.mainnet.local generated by
# `npm run mainnet:configure`. This exact phrase is consumed after one broadcast.
MAINNET_BROADCAST_CONFIRMATION=
